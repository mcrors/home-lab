network:
  version: 2
  renderer: networkd
  ethernets:
    {{ net_interface }}:
      addresses:
        - {{ static_ip }}/24
      routes:
        - to: default
          via: {{ gateway }}
      nameservers:
        addresses:
          - {{ k3s_pihole_1_dns_ip }}
          - {{ k3s_pihole_2_dns_ip }}
