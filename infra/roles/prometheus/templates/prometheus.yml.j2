global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'node_exporter'
    relabel_configs:
      - target_label: cluster
        replacement: '{{ prometheus_cluster_name }}'
    static_configs:
      - targets:
          {% for host in groups['all_nodes'] %}
          - '{{ host }}:9100'  # Use the hostname instead of the IP
          {% endfor %}
          - 'lib-hp-01.home:9100'  # manually adding this node as it doesn't play well with the ansible role

  - job_name: 'kubelet-cadvisor'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token: '{{ prometheus_scraper_token }}'
    metrics_path: /metrics/cadvisor
    relabel_configs:
      - target_label: cluster
        replacement: '{{ prometheus_cluster_name }}'
    static_configs:
      - targets:
          {% for host in groups['k3s_cluster'] %}
          - '{{ host }}:10250'
          {% endfor %}

  - job_name: 'kubelet'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    bearer_token: '{{ prometheus_scraper_token }}'
    metrics_path: /metrics
    relabel_configs:
      - target_label: cluster
        replacement: '{{ prometheus_cluster_name }}'
    # k3s serves apiserver, etcd and kubelet metrics from one registry on :10250,
    # so an unfiltered scrape adds ~71k series. Keep only what the PVC dashboards
    # need; widen this regex to pick up more.
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: 'kubelet_volume_stats_.*|kubelet_running_.*|kubelet_node_name'
        action: keep
    static_configs:
      - targets:
          {% for host in groups['k3s_cluster'] %}
          - '{{ host }}:10250'
          {% endfor %}

  - job_name: longhorn
    metrics_path: /metrics
    static_configs:
      - targets:
          {% for host in groups['longhorn'] %}
          - '{{ host }}:30950'
          {% endfor %}

  - job_name: 'kube-state-metrics'
    scheme: https
    tls_config:
      insecure_skip_verify: true
    relabel_configs:
      - target_label: cluster
        replacement: '{{ prometheus_cluster_name }}'
    static_configs:
      - targets:
          - 'ksm.houli.eu:443'

  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: blackbox # To get metrics about the exporter itself
    scheme: https
    metrics_path: /metrics
    static_configs:
      - targets:
        - blackbox.houli.eu

  - job_name: blackbox-http
    scheme: https
    metrics_path: /probe
    params:
      module: [http_2xx]
    # Targets that ingress discovery cannot see. Everything with a Kubernetes
    # Ingress is handled by blackbox-ingress below.
    static_configs:
    - targets:
      - https://prometheus.houli.eu
      - http://omv.houli.eu
      - https://traefik.houli.eu
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        regex: (https?://[^/]+)(?:/.*)?
        replacement: ${1}
        target_label: instance
      - target_label: __address__
        replacement: blackbox.houli.eu

  # Probe targets discovered from Ingress objects carrying prometheus.io/probe=true.
  # Runs alongside blackbox-http while we confirm discovery works; the static job
  # shrinks to the out-of-cluster targets once this is proven.
  - job_name: blackbox-ingress
    scheme: https
    metrics_path: /probe
    kubernetes_sd_configs:
      - role: ingress
        api_server: https://{{ master_ip }}:6443
        bearer_token: '{{ prometheus_scraper_token }}'
        tls_config:
          insecure_skip_verify: true
    relabel_configs:
      # Opt-in: skip every ingress that has not asked to be probed.
      - source_labels: [__meta_kubernetes_ingress_annotation_prometheus_io_probe]
        regex: "true"
        action: keep

      # Default probe URL: scheme://host + the path the Ingress declares.
      - source_labels:
          - __meta_kubernetes_ingress_scheme
          - __meta_kubernetes_ingress_host
          - __meta_kubernetes_ingress_path
        separator: ;
        regex: (.+);(.+);(.*)
        replacement: ${1}://${2}${3}
        target_label: __param_target

      # Override for services whose health page is not at the Ingress path
      # (plex needs /web/index.html, jenkins will need /login). The third capture
      # group requires a non-empty annotation, so this rule is a no-op without one
      # and the default above survives.
      - source_labels:
          - __meta_kubernetes_ingress_scheme
          - __meta_kubernetes_ingress_host
          - __meta_kubernetes_ingress_annotation_prometheus_io_probe_path
        separator: ;
        regex: (.+);(.+);(.+)
        replacement: ${1}://${2}${3}
        target_label: __param_target

      # Same default-then-override shape for the blackbox module.
      - target_label: __param_module
        replacement: http_2xx
      - source_labels: [__meta_kubernetes_ingress_annotation_prometheus_io_probe_module]
        regex: (.+)
        target_label: __param_module

      # Keep instance as a bare host, matching blackbox-http.
      - source_labels: [__param_target]
        regex: (https?://[^/]+)(?:/.*)?
        replacement: ${1}
        target_label: instance

      # Carry the ingress identity through so probe alerts can be joined against
      # kube-state-metrics alerts for the same workload.
      - source_labels: [__meta_kubernetes_namespace]
        target_label: namespace
      - source_labels: [__meta_kubernetes_ingress_name]
        target_label: ingress

      # Scrape the exporter, not the target.
      - target_label: __address__
        replacement: blackbox.houli.eu

rule_files:
  - "rules/*.yml"

alerting:
  alertmanagers:
    - scheme: https
      tls_config:
        insecure_skip_verify: true
      static_configs:
        - targets: ['alertmanager.houli.eu:443']
