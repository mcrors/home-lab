apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: longhorn-ingress
  namespace: {{ longhorn_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.tls: "true"
    prometheus.io/probe: "true"
    gethomepage.dev/enabled: "true"
    gethomepage.dev/name: "Longhorn"
    gethomepage.dev/group: "Infra"
    gethomepage.dev/icon: "longhorn"
    gethomepage.dev/description: "Distributed block storage"
    # Longhorn pods use a bare `app` label; scope the tag to the UI.
    gethomepage.dev/pod-selector: "app=longhorn-ui"
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - {{ longhorn_host }}
  rules:
    - host: {{ longhorn_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ longhorn_service }}
                port:
                  number: 80
